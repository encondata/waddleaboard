# Waddle Aboard configuration. Every setting is optional: `docker compose up` works with no .env.
# Passwords and secrets left empty are generated on first start and kept in the secrets volume.
# install.sh writes a real .env (mode 600) with its own. Never commit .env.

# --- web ---
# host port for the site
WEB_PORT=8430
# host interface to bind (127.0.0.1 for local only)
WEB_BIND=0.0.0.0
# nginx upload limit; keep above PHOTO_MAX_BYTES
WEB_MAX_BODY_SIZE=12m
# the address people use (your reverse proxy's https:// URL); printed by install.sh
SITE_URL=http://localhost:8430

# --- database (PostgreSQL) ---
POSTGRES_DB=waddleaboard
POSTGRES_USER=waddle
# set before the first start or never: the database keeps the password it was created with
POSTGRES_PASSWORD=

# --- photo storage (MinIO "spaces") ---
MINIO_ROOT_USER=waddle
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=waddleaboard-photos
# upstream tag built by deploy/minio.Dockerfile
MINIO_RELEASE=RELEASE.2025-10-15T17-29-55Z

# --- api ---
# at least 32 characters when set
SESSION_SECRET=
# login lifetime
SESSION_TTL_HOURS=168
# set 1 once the site is served over HTTPS
COOKIE_SECURE=0
# 8 MB
PHOTO_MAX_BYTES=8388608
# failed logins per IP+username before a lockout
LOGIN_MAX_FAILURES=5
# lockout window
LOGIN_WINDOW_MINUTES=15
# apply db/migrations at api startup
RUN_MIGRATIONS=1
# 1 = load the sample ducks/finds (Sunny DP-0427 and friends)
SEED_DEMO=0

# --- storage ---
# Unset, the database and photos live in the named volumes postgres-data and minio-data.
# Set absolute host folders to keep them there instead (install.sh does). Never use a path
# relative to the checkout: deployers such as Slipway replace it on every deploy. Generated
# secrets live in the secrets volume, or WADDLE_SECRETS_DIR; back it up with the data.
# WADDLE_POSTGRES_DIR=/srv/waddleaboard/data/postgres
# WADDLE_MINIO_DIR=/srv/waddleaboard/data/minio
# WADDLE_SECRETS_DIR=/srv/waddleaboard/data/secrets

# --- first administrator ---
# The api creates this account at startup while there is no administrator yet; after that
# these are ignored. With no password, one is generated and printed once in the api log.
WADDLE_ADMIN_USER=admin
WADDLE_ADMIN_PASSWORD=
