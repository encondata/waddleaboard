{
  "name": "waddleaboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "api",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"api/test/**/*.test.js\" \"web/test/**/*.test.js\"",
