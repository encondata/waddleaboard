# Rendered by the nginx image's envsubst step; only defined env vars (WEB_MAX_BODY_SIZE) are replaced.

# Rate limits, per client address. Only posting a find and logging in are counted (other
# requests map to an empty key, which nginx does not limit).
map "$request_method $uri" $finds_limit_key {
  "~^POST /api/ducks/[^/]+/finds/?$" $binary_remote_addr;
  default "";
}
map "$request_method $uri" $login_limit_key {
  "~^POST /api/auth/login/?$" $binary_remote_addr;
  default "";
}
limit_req_zone $finds_limit_key zone=finds:10m rate=10r/m;
limit_req_zone $login_limit_key zone=login:10m rate=10r/m;

server {
  # IPv4 only: Docker publishes the port on both, and an IPv6 listener here would stop nginx
  # starting on hosts with IPv6 turned off.
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  # The client's real address when a reverse proxy forwards for it. X-Forwarded-For is believed
  # only from private networks (where such a proxy runs); from anywhere else it is ignored, so a
  # client reaching this port directly from the internet cannot pretend to be someone else.
  set_real_ip_from 10.0.0.0/8;
  set_real_ip_from 172.16.0.0/12;
  set_real_ip_from 192.168.0.0/16;
  set_real_ip_from 100.64.0.0/10;
  set_real_ip_from 127.0.0.0/8;
  set_real_ip_from fc00::/7;
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;

  client_max_body_size ${WEB_MAX_BODY_SIZE};
  server_tokens off;
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  # Docker's embedded DNS, so a restarted api container is found again.
  resolver 127.0.0.11 valid=10s ipv6=off;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # nginx-generated errors on /api/ still answer in the API's JSON error shape.
  location @api_too_large {
    default_type application/json;
    return 413 '{"error":{"code":"payload_too_large","message":"That upload is too large."}}';
  }
  location @api_rate_limited {
    default_type application/json;
    add_header Retry-After 60 always;
    return 429 '{"error":{"code":"rate_limited","message":"That is a lot of requests at once. Please wait a minute and try again."}}';
  }
  location @api_unavailable {
    default_type application/json;
    return 503 '{"error":{"code":"api_unavailable","message":"The Waddle Aboard API is not reachable right now."}}';
  }

  location /api/ {
    limit_req zone=finds burst=20 nodelay;
    limit_req zone=login burst=10 nodelay;
    limit_req_status 429;
    error_page 429 @api_rate_limited;
    error_page 413 @api_too_large;
    error_page 502 503 504 @api_unavailable;
    set $api_upstream http://api:3000;
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
  }

  location /assets/ {
    expires 7d;
    try_files $uri =404;
  }

  # SPA fallback: every other path renders index.html and the client router decides.
  location / {
    expires -1;
    try_files $uri $uri/ /index.html;
  }
}
