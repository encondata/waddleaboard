# Rendered by the nginx image's envsubst step; only defined env vars (WEB_MAX_BODY_SIZE) are replaced.
server {
  listen 80;
  listen [::]:80;
  server_name _;
  root /usr/share/nginx/html;

  client_max_body_size ${WEB_MAX_BODY_SIZE};
  server_tokens off;
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  # Docker's embedded DNS, so a restarted api container is found again.
  resolver 127.0.0.11 valid=10s ipv6=off;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # nginx-generated errors on /api/ still answer in the API's JSON error shape.
  location @api_too_large {
    default_type application/json;
    return 413 '{"error":{"code":"payload_too_large","message":"That upload is too large."}}';
  }
  location @api_unavailable {
    default_type application/json;
    return 503 '{"error":{"code":"api_unavailable","message":"The Waddle Aboard API is not reachable right now."}}';
  }

  location /api/ {
    error_page 413 @api_too_large;
    error_page 502 503 504 @api_unavailable;
    set $api_upstream http://api:3000;
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
  }

  location /assets/ {
    expires 7d;
    try_files $uri =404;
  }

  # SPA fallback: every other path renders index.html and the client router decides.
  location / {
    expires -1;
    try_files $uri $uri/ /index.html;
  }
}
